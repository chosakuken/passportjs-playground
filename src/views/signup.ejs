<!DOCTYPE html>
<head>
    <meta charset="utf-8">
    <title>PassPort.js 動作確認</title>
</head>
<body>
    <h1>ユーザ登録</h1>
    <form action="/signup" method="post">
        <label>ユーザ名</label>
        <input name="username" type="text" required>
        <label>パスワード</label>
        <input name="password" type="text" required>
        <button type="submit">登録</button>
    </form>
</body>